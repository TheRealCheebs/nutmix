# =============================
# Nutmix Environment Variables
# =============================
# Copy this file to .env and fill in the required values.
# See docs/DEVELOPMENT.md for more details.

# --- Mint Keys ---
# Hex-encoded 32 byte keys required for operation.
# Generate with: make gen-test-keys
MINT_PRIVATE_KEY=""        # Private key for the mint (hex, 32 bytes)
ADMIN_NOSTR_NPUB=""        # Admin Nostr public key (hex, 32 bytes)

# --- Database Configuration ---
POSTGRES_USER="postgres"   # Database username
POSTGRES_PASSWORD=""       # Database password (use a strong password)

# For Docker development/production:
DATABASE_URL="postgres://postgres:admin@db/postgres"
# For local development:
# DATABASE_URL="postgres://postgres:admin@localhost:5432/postgres"

# --- Hosting & Certificates ---
LE_EMAIL_ADDRESS="email@forletsencrypt.com"   # Email for Let's Encrypt
MINT_HOSTNAME="mint.example.com"              # Public hostname for mint
TRAEFIK_HOSTNAME="traefik.example.com"       # Hostname for Traefik proxy

# --- Deployment Mode ---
# Set to 'prod' for production, 'dev' for development
MODE="prod"

# --- Signer Configuration ---
# Type of signer used by the mint
SIGNER_TYPE="memory"        # Options: memory, abstract_socket, network
# SIGNER_TYPE="abstract_socket"
# SIGNER_TYPE="network"

# Paths for certificates (used for remote signer)
SIGNER_CLIENT_TLS_KEY="tls/client-cert.pem"
SIGNER_CLIENT_TLS_CERT="tls/client-key.pem"
SIGNER_CA_CERT="tls/ca-cert.pem"

# For network signer:
# NETWORK_SIGNER_ADDRESS="localhost:1721"

# --- Keycloak Authentication ---
KEYCLOAK_POSTGRES_DB=keycloak_db
KEYCLOAK_POSTGRES_USER=keycloak_db_user
KEYCLOAK_POSTGRES_PASSWORD=keycloak_db_user_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=password
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_HOSTNAME_PORT=8081